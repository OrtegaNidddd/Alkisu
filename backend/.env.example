# BASE DE DATOS (PostgreSQL con Prisma ORM)
# Formato: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Si usas Supabase Pooler (Transaction Mode), asegúrate de usar el puerto 5432 o 6543
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password_seguro@localhost:5432/papoi_db?schema=public"

# ------------------------------------------------------------------------------
# SEGURIDAD Y AUTENTICACIÓN
# Clave secreta para la firma y verificación de JSON Web Tokens (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="genera_una_clave_secreta_larga_y_aleatoria_para_jwt_aqui"

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS EN LA NUBE (Supabase Storage)
# Utilizado para bocetos, renders 3D, fotos de calidad y certificados
# ------------------------------------------------------------------------------
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_supabase_service_role_key_secreta"
SUPABASE_STORAGE_BUCKET="jewelry-assets"

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO TRANSACCIONAL (Brevo / Sendinblue)
# Utilizado para notificaciones reactivas de stock mínimo de metales y piedras
# ------------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-tu_clave_api_de_brevo_aqui"
BREVO_SENDER_EMAIL="notificaciones@papoi.com"
BREVO_SENDER_NAME="Papoi Taller de Joyería"
ADMIN_NOTIFICATION_EMAIL="gerencia@papoi.com"
