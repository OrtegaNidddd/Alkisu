# ==============================================================
# ALKISU ERP - PLANTILLA DE VARIABLES DE ENTORNO DOCKER
# ==============================================================

# Conexión a Base de Datos PostgreSQL (ej. Supabase o PostgreSQL local)
DATABASE_URL="postgresql://usuario:password@host:5432/postgres?sslmode=require"

# Llave secreta para firma de JSON Web Tokens (mínimo 32 caracteres)
JWT_SECRET="tu_clave_secreta_jwt_super_segura"

# Configuración de Supabase Storage para CDN de bocetos y fotos
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_secret_service_role_key"
SUPABASE_STORAGE_BUCKET="jewelry-assets"

# Notificaciones y Alertas por Email vía Brevo (Sendinblue)
BREVO_API_KEY="tu_api_key_de_brevo"
BREVO_SENDER_EMAIL="notificaciones@alkisu.com"
BREVO_SENDER_NAME="Alkisu Joyería"
ADMIN_NOTIFICATION_EMAIL="admin@alkisu.com"

# Puerto del servidor backend
PORT=4000
